# --- VLM backend: auto | openai | anthropic | ollama | heuristic ---
# auto = first of openai / anthropic whose key is set, else ollama if reachable, else heuristic (offline demo mode)
OMNISIGHT_VLM=auto
OPENAI_API_KEY=
OMNISIGHT_OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
OMNISIGHT_ANTHROPIC_MODEL=claude-sonnet-4-5
OLLAMA_HOST=http://localhost:11434
OMNISIGHT_OLLAMA_MODEL=llava

# --- GitHub (leave GITHUB_TOKEN empty for dry-run: PR preview is written to disk) ---
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
OMNISIGHT_CSS_PATH=src/omnisight-fixes.css
OMNISIGHT_AUTO_MERGE_ON_APPROVE=false

# --- Gateway ---
OMNISIGHT_API_KEY=          # protects /api/* and /webhook/ci (send as X-API-Key / Bearer)
OMNISIGHT_PUBLIC_URL=http://localhost:8000
OMNISIGHT_RUNS_DIR=runs
OMNISIGHT_MAX_ATTEMPTS=3
OMNISIGHT_VIEWPORTS=iphone-se:320x568:m,iphone-14:375x812:m,ipad:768x1024:m,desktop:1440x900
